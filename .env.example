# ---- Runtime ----
ENVIRONMENT=local            # local | staging | production
AUTH_MODE=dev                # dev (trusted headers) | oidc (week 4). dev is refused in production.
DEFAULT_TENANT=limaupay

# ---- Data stores ----
DATABASE_URL=postgresql+asyncpg://kyc:kyc@postgres:5432/kyc
REDIS_URL=redis://redis:6379/0
# POSTGRES_HOST_PORT=5433    # host port for psql/GUI tools if 5432 is taken (default 5432)

# ---- AI gateway (LiteLLM). The app only ever talks to the gateway. ----
LLM_BASE_URL=http://litellm:4000/v1
LLM_API_KEY=sk-local-change-me
LITELLM_MASTER_KEY=sk-local-change-me
CHAT_MODEL=chat-default
EMBED_MODEL=embed-default
EMBEDDING_DIM=1536
EMBED_BATCH_SIZE=16

# Provider keys used by config/litellm/local.yaml (only the gateway reads these)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Adapters: swap clouds by changing these, not code ----
STORAGE_PROVIDER=local       # local | gcp | aws* | azure*   (*placeholder)
QUEUE_PROVIDER=arq           # arq | gcp | aws* | azure*
OCR_PROVIDER=local           # local | gcp | aws* | azure*
PII_PROVIDER=presidio        # presidio | regex | gcp | aws* | azure*
KYC_STATUS_PROVIDER=mock     # mock (synthetic core-banking stand-in)
